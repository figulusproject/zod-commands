{
  "name": "zod-intake",
  "private": true,
  "description": "Zod schema-driven parsing for how a program takes input from a person: CLI flags, interactive prompts, and the introspection layer shared between them.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "docsify serve docs",
    "sync-versions": "tsx scripts/sync-versions.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.10",
    "docsify-cli": "^5.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/figulusproject/zod-intake"
  },
  "author": "The Figulus Project",
  "license": "MIT"
}
