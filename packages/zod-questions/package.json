{
  "name": "zod-questions",
  "version": "0.1.0",
  "description": "Define an interactive terminal prompt flow's questions once as Zod schemas plus a small sibling metadata object, and get the widget for each one, a typed and validated answer set, and reprompt-on-invalid-input for free.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "cp ../../LICENSE ./LICENSE"
  },
  "dependencies": {
    "zod-introspect": "^1.0.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0",
    "@clack/prompts": "^1.7.0"
  },
  "peerDependenciesMeta": {
    "@clack/prompts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/node": "^22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/figulusproject/zod-intake",
    "directory": "packages/zod-questions"
  },
  "author": "The Figulus Project",
  "license": "MIT"
}
